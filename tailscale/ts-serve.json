{
	"TCP": {
		"443": { "HTTPS": true },
		"8443": { "HTTPS": true },
		"9443": { "HTTPS": true },
		"10443": { "HTTPS": true }
	},
	"Web": {
		"${TS_CERT_DOMAIN}:443": {
			"Handlers": {
				"/": { "Proxy": "http://127.0.0.1:9080" }
			}
		},
		"${TS_CERT_DOMAIN}:8443": {
			"Handlers": {
				"/": { "Proxy": "http://127.0.0.1:9081" }
			}
		},
		"${TS_CERT_DOMAIN}:9443": {
			"Handlers": {
				"/": { "Proxy": "http://127.0.0.1:9082" }
			}
		},
		"${TS_CERT_DOMAIN}:10443": {
			"Handlers": {
				"/": { "Proxy": "http://127.0.0.1:9083" }
			}
		}
	},
	"AllowFunnel": {
		"${TS_CERT_DOMAIN}:443": false,
		"${TS_CERT_DOMAIN}:8443": false,
		"${TS_CERT_DOMAIN}:9443": false,
		"${TS_CERT_DOMAIN}:10443": false
