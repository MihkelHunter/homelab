# Copy to .env and fill in values. NEVER commit .env.

# Email used by Let's Encrypt for certificate renewal notices
ACME_EMAIL=you@example.com

# Shared family login for both apps (used by Caddy basicauth)
# Generate the password hash on the server with:
#   docker run --rm caddy:2.9-alpine caddy hash-password
#   (then paste the $2a$... output below)
AUTH_USER=family
AUTH_PASSWORD_HASH=$2a$14$REPLACE_ME

# Tailscale (LOCAL ONLY, docker-compose.tailscale.yml).
# The on/off switch is the compose profile, not this file — see SETUP.md.
# The apps stay reachable on checklist.localhost etc. either way.
#
# Auth key: https://login.tailscale.com/admin/settings/keys
# Add &ephemeral=true so the node disappears from your devices when it stops.
TAILSCALE_AUTHKEY=tskey-auth-REPLACE_ME

# Node name -> https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=homelab
